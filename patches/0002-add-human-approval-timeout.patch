+  }
+  if (!Number.isFinite(value) || value < 0 || value > MAX_APPROVAL_TIMEOUT_MINUTES) {
+    throw new RangeError(`auto-review: ${APPROVAL_TIMEOUT_RANGE}; got ${String(value)}`)
+  }
