  */
 export const Config = z.object({
   approvalTimeoutMinutes: z.number().min(0).max(MAX_APPROVAL_TIMEOUT_MINUTES).default(0).volatile(),
+  autoDenyReviewerRejections: z.boolean().default(false).volatile(),
 })
 
